{
  "name": "crm-autosale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npx prisma generate",
    "dev": "next dev -H 0.0.0.0",
    "dev:db": "npx prisma generate && npx prisma migrate deploy",
    "dev:full": "npm run dev:db && npm run dev",
    "build": "npx prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "icons": "node scripts/generate-icons.mjs",
    "db:migrate": "npx prisma migrate deploy",
    "db:reset": "npx prisma db seed",
    "db:seed-demo": "npx tsx scripts/seed-demo.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/sharp": "^0.31.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.2",
    "sonner": "^1.7.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "postcss": "^8.5.15",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
